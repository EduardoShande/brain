# Copy this file to ".env" (which is gitignored) and fill in real values.
# Docker Compose reads .env automatically.

# Postgres
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=brain

# How the API connects to Postgres (host "db" is the compose service name)
DATABASE_URL=postgresql://brain:brain@db:5432/brain

# Auth secret. Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
